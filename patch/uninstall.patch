+/** Windows 上进程刚退出时目录可能还被占着，重试几次。 */
+async function removeTree(dir: string) {
+  for (let i = 0; i < 8; i++) {
+    try {
+      await rm(dir, { recursive: true, force: true });
+      return;
+    } catch (error: any) {
+      if (i === 7) throw error;
+      await new Promise((r) => setTimeout(r, 150 * (i + 1)));
+    }
+  }
+}
